{
  "entities": {
    "SaveSlot": {
      "title": "SaveSlot",
      "description": "Cloud save state for a player's Ashen Glyph expedition slot",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Authenticated Firebase UID of the save owner"
        },
        "starterClass": {
          "type": "string",
          "enum": ["Vanguard", "Shadowcraft", "Runecaster", "Wanderer"],
          "maxLength": 32,
          "description": "Initial discipline chosen for this run"
        },
        "level": {
          "type": "integer",
          "description": "Current character level"
        },
        "zoneId": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "maxLength": 32,
          "description": "Current zone identifier"
        },
        "zoneName": {
          "type": "string",
          "maxLength": 80,
          "description": "Human-readable zone title"
        },
        "buildTitle": {
          "type": "string",
          "maxLength": 64,
          "description": "Dynamic hybrid build title"
        },
        "kills": {
          "type": "integer",
          "description": "Total foes defeated in this run"
        },
        "gold": {
          "type": "integer",
          "description": "Current gold carried"
        },
        "savePayload": {
          "type": "object",
          "description": "Full structured RPG run state (player, zones, flags, quests, merchants, logs)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when save slot was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when save slot was last updated"
        }
      },
      "required": [
        "ownerId",
        "starterClass",
        "level",
        "zoneId",
        "zoneName",
        "buildTitle",
        "kills",
        "gold",
        "savePayload",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChronicleEntry": {
      "title": "ChronicleEntry",
      "description": "Immutable Hall of Fame record of a victorious or fallen expedition",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "outcome": {
          "type": "string",
          "enum": ["victory", "fallen"],
          "maxLength": 16
        },
        "starterClass": {
          "type": "string",
          "enum": ["Vanguard", "Shadowcraft", "Runecaster", "Wanderer"],
          "maxLength": 32
        },
        "buildTitle": {
          "type": "string",
          "maxLength": 64
        },
        "level": {
          "type": "integer"
        },
        "deepestDepth": {
          "type": "integer"
        },
        "kills": {
          "type": "integer"
        },
        "turnsElapsed": {
          "type": "integer"
        },
        "gold": {
          "type": "integer"
        },
        "keyDecisions": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "outcome",
        "starterClass",
        "buildTitle",
        "level",
        "deepestDepth",
        "kills",
        "turnsElapsed",
        "gold",
        "keyDecisions",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/saves/{saveId}": {
      "schema": { "$ref": "#/entities/SaveSlot" },
      "description": "Private user-owned expedition save slots (slot_1, slot_2, slot_3, active)"
    },
    "/users/{userId}/chronicles/{entryId}": {
      "schema": { "$ref": "#/entities/ChronicleEntry" },
      "description": "Private user-owned Hall of Fame expedition chronicles"
    }
  }
}
